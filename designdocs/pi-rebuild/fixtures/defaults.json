{
  "schemaVersion": 1,
  "engineId": "pi",
  "runtime": "pi-durable",
  "piVersion": "1.3.0",
  "toolExecution": "sequential",
  "hostExecutionMode": "strict",
  "maxActiveRoots": 2,
  "maxChildrenPerRoot": 3,
  "maxChildDepth": 2,
  "maxModelAttemptsPerRun": 32,
  "maxToolsPerRun": 64,
  "requestTimeoutMs": 120000,
  "activeRunTimeoutMs": 900000,
  "approvalTtlMs": 600000,
  "storeIdleCloseMs": 60000,
  "storeWarnBytes": 16777216,
  "storeRolloverBytes": 33554432,
  "nativeCommandTimeoutSeconds": 60,
  "nativeCommandMaxSeconds": 300,
  "toolRetainedOutputBytes": 65536,
  "shellSpillMaxBytes": 4194304,
  "mcpTestRequestMs": 15000,
  "mcpTestTotalMs": 20000,
  "mcpTestCloseMs": 2000,
  "mcpMaxTools": 500,
  "mcpMaxDirectTools": 40,
  "subagentInputMaxFiles": 8,
  "subagentInputMaxBytes": 131072,
  "autoResumeAfterRestart": false,
  "implicitEnvironmentCredentials": false,
  "installExternalBinaries": false,
  "apiCredentialsStorage": "obsidian-secret-storage",
  "durableStorage": "jsonl-fsync",
  "storageLocation": "local-os-state-outside-vault",
  "progressPartialIntervalMs": 100,
  "progressOutputIntervalMs": 100
}
