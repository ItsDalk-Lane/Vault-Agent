{
  "schemaVersion": 1,
  "note": "resolvedZone、actor、trustedTool是宿主解析结果，不是模型可提交字段。路径解析单独测试。错误码可在16目录中增补，但不能改变判定。",
  "cases": [
    {
      "id": "POL-01",
      "toolFamily": "vault",
      "resolvedZone": "vault",
      "mode": "default",
      "effect": "read",
      "inScope": true,
      "expected": "allow",
      "reason": "项目范围内普通读取"
    },
    {
      "id": "POL-02",
      "toolFamily": "vault",
      "resolvedZone": "vault",
      "mode": "default",
      "effect": "write",
      "inScope": true,
      "expected": "ask",
      "reason": "普通写入需要审批"
    },
    {
      "id": "POL-03",
      "toolFamily": "vault",
      "resolvedZone": "vault",
      "mode": "plan",
      "effect": "write",
      "code": "READ_ONLY_MODE",
      "expected": "deny",
      "reason": "只读模式不写用户资源"
    },
    {
      "id": "POL-04",
      "toolFamily": "vault",
      "resolvedZone": "vault",
      "mode": "auto",
      "effect": "write",
